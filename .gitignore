# Python virtual environment
.venv/
venv/
ENV/

# Python caches and tooling
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.pytest_cache/
.ruff_cache/

# SQLite databases, journals, and backups
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backups/

# Data: ignore all real/private data, but track test fixtures
data/*
!data/fixtures/

# Recordings & IDE logs
*.webm
*.webp
*.mp4
# Scratch files
scratch/
